# Copia este archivo a .env y ajusta los valores.
# Supabase (Project Settings -> Database -> Connection string). Ver DEPLOY.md.
# App (pooler, puerto 6543):
DATABASE_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Directa (puerto 5432), solo para `npx prisma db push`:
DIRECT_URL="postgresql://postgres.PROYECTO:CLAVE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Storage (fotos y modelos 3D). Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""   # secreta: nunca la subas a GitHub ni la uses en el navegador
SUPABASE_BUCKET="vehiculos"

# Secreto para firmar la sesión del admin. Genera uno con:  openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo"

# Usuario admin que crea el seed (npm run db:seed). Si omites la clave, el seed genera una y la imprime.
ADMIN_EMAIL="admin@patio.local"
ADMIN_PASSWORD=""

# Datos públicos del patio
NEXT_PUBLIC_PATIO_NAME="ASTOREL"
NEXT_PUBLIC_WHATSAPP="" # formato 5939XXXXXXXX

# Opcional: con una clave el chatbot responde con Claude; sin ella usa reglas locales.
ANTHROPIC_API_KEY=""
CHAT_MODEL="claude-haiku-5-5"

# Modelo para el asistente financiero (opcional)
FINANCE_MODEL=claude-sonnet-5-5
